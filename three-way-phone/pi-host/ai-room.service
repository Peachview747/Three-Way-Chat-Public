[Unit]
Description=AI Room Raspberry Pi host
After=NetworkManager.service
Wants=NetworkManager.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ai-room
Group=ai-room
WorkingDirectory=/var/lib/ai-room
Environment=HOME=/var/lib/ai-room
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/ai-room/service.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-room

[Install]
WantedBy=multi-user.target
